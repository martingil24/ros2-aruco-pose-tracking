<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aruco_perception</name>
  <version>0.2.0</version>
  <description>ArUco-based 2D localization of multiple robots with an overhead camera</description>
  <maintainer email="martin15525@icloud.com">Martín Gil Planchadell</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <depend>aruco_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
